+  // GeneralsX @bugfix HishamAbulfeilat 28/09/2026 Android returns VK_SUBOPTIMAL_KHR from
+  // every acquire and present while the swapchain's preTransform (always IDENTITY here)
+  // differs from the display's rotation hint, i.e. on any phone (natural orientation
+  // portrait) running the game in landscape. The compositor rotates the image, so the
+  // swapchain stays valid; treating SUBOPTIMAL as "recreate" rebuilt the swapchain every
+  // frame, churning GPU memory until DxvkMemoryAllocator crashed (Adreno 830, S25 Ultra).
+  // A real size change still arrives as VK_ERROR_OUT_OF_DATE_KHR and recreates it.
+  static bool isUsableSwapchainStatus(VkResult vr) {
+#ifdef __ANDROID__
+    return vr == VK_SUCCESS || vr == VK_SUBOPTIMAL_KHR;
+#else
+    return vr == VK_SUCCESS;
+#endif
+  }
